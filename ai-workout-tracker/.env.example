# Email (Resend) — used for verification emails. If RESEND_API_KEY is empty,
# verification links are printed to the server console instead (dev mode).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=