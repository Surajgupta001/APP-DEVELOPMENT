# Expo public API URL for the app
EXPO_PUBLIC_API_URL=

# Database URL for NeonDB   
DATABASE_URL=

# Imagekit API Key
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Groq (AI Coach)
GROQ_API_KEY=

# Better Auth
BETTER_AUTH_URL=
